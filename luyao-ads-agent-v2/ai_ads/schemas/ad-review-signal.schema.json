{
  "$defs": {
    "EvidenceClassification": {
      "enum": [
        "SUPPORT",
        "OPPOSE",
        "INCONCLUSIVE",
        "SCOPE_LIMITED",
        "CONFLICT",
        "UNSTABLE"
      ],
      "title": "EvidenceClassification",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Action Id"
    },
    "action_pack_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Action Pack Id"
    },
    "actual_direction": {
      "title": "Actual Direction",
      "type": "string"
    },
    "batch_id": {
      "title": "Batch Id",
      "type": "string"
    },
    "candidate_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Version"
    },
    "classification": {
      "$ref": "#/$defs/EvidenceClassification"
    },
    "continue_observing": {
      "items": {
        "type": "string"
      },
      "title": "Continue Observing",
      "type": "array"
    },
    "expected_direction": {
      "title": "Expected Direction",
      "type": "string"
    },
    "external_event_notes": {
      "items": {
        "type": "string"
      },
      "title": "External Event Notes",
      "type": "array"
    },
    "metric_changes": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Metric Changes",
      "type": "object"
    },
    "plan_id": {
      "title": "Plan Id",
      "type": "string"
    },
    "rule_id": {
      "title": "Rule Id",
      "type": "string"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "threshold_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Threshold Id"
    }
  },
  "required": [
    "schema_version",
    "plan_id",
    "batch_id",
    "rule_id",
    "classification",
    "expected_direction",
    "actual_direction"
  ],
  "title": "AdReviewSignal",
  "type": "object"
}
