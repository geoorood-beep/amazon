{
  "$defs": {
    "ActionExecutionRecord": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "title": "Action Id",
          "type": "string"
        },
        "actual_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Value"
        },
        "executed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Executed At"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "planned_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Planned Value"
        },
        "status": {
          "$ref": "#/$defs/ExecutionStatus"
        }
      },
      "required": [
        "action_id",
        "status"
      ],
      "title": "ActionExecutionRecord",
      "type": "object"
    },
    "ExecutionStatus": {
      "enum": [
        "EXECUTED",
        "SKIPPED",
        "PARTIAL",
        "FAILED"
      ],
      "title": "ExecutionStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action_records": {
      "items": {
        "$ref": "#/$defs/ActionExecutionRecord"
      },
      "title": "Action Records",
      "type": "array"
    },
    "batch_id": {
      "title": "Batch Id",
      "type": "string"
    },
    "executed_as_planned": {
      "title": "Executed As Planned",
      "type": "boolean"
    },
    "executed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Executed At"
    },
    "operator": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operator"
    },
    "plan_id": {
      "title": "Plan Id",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "batch_id",
    "executed_as_planned"
  ],
  "title": "ExecutionConfirmation",
  "type": "object"
}
