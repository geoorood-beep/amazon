{
  "schema_version": "1.0",
  "tool_status": "ACTIVE_LOCAL_TOOL",
  "allowed_category": "rug",
  "data_mode": "FULL",
  "required_report_ids": [
    "sp_search_terms_daily",
    "sp_search_terms_summary",
    "sp_targeting",
    "sp_placement",
    "sp_advertised_product",
    "campaign_ad_group_settings"
  ],
  "input_extensions": [
    ".csv",
    ".tsv",
    ".xlsx"
  ],
  "technical_reconciliation_tolerance": {
    "count_absolute": "0",
    "money_absolute": "0.01",
    "purpose": "仅用于处理金额二位小数舍入差，不是广告业务阈值"
  },
  "report_requirements": {
    "sp_search_terms_daily": {
      "required": [
        "date",
        "campaign_id",
        "ad_group_id",
        "target_id",
        "search_term",
        "impressions",
        "clicks",
        "orders",
        "spend",
        "sales"
      ],
      "optional": [
        "currency",
        "marketplace"
      ]
    },
    "sp_search_terms_summary": {
      "required": [
        "campaign_id",
        "ad_group_id",
        "target_id",
        "search_term",
        "impressions",
        "clicks",
        "orders",
        "spend",
        "sales"
      ],
      "optional": [
        "period_start",
        "period_end",
        "currency",
        "marketplace"
      ]
    },
    "sp_targeting": {
      "required": [
        "campaign_id",
        "ad_group_id",
        "target_id",
        "target_text",
        "match_type",
        "bid",
        "target_status"
      ],
      "optional": [
        "period_start",
        "period_end",
        "currency",
        "marketplace",
        "impressions",
        "clicks",
        "orders",
        "spend",
        "sales"
      ]
    },
    "sp_placement": {
      "required": [
        "campaign_id",
        "placement",
        "impressions",
        "clicks",
        "orders",
        "spend",
        "sales"
      ],
      "optional": [
        "period_start",
        "period_end",
        "currency",
        "marketplace"
      ]
    },
    "sp_advertised_product": {
      "required": [
        "campaign_id",
        "ad_group_id",
        "impressions",
        "clicks",
        "orders",
        "spend",
        "sales"
      ],
      "one_of": [
        [
          "sku",
          "asin"
        ]
      ],
      "optional": [
        "period_start",
        "period_end",
        "currency",
        "marketplace",
        "sku",
        "asin"
      ]
    },
    "campaign_ad_group_settings": {
      "required": [
        "campaign_id",
        "campaign_name",
        "campaign_status",
        "daily_budget",
        "ad_group_id",
        "ad_group_name",
        "ad_group_status",
        "default_bid"
      ],
      "optional": [
        "period_start",
        "period_end",
        "currency",
        "marketplace"
      ]
    }
  },
  "column_aliases": {
    "date": ["Date", "日期", "报告日期"],
    "period_start": ["Start Date", "Report Start Date", "开始日期", "报告开始日期"],
    "period_end": ["End Date", "Report End Date", "结束日期", "报告结束日期"],
    "marketplace": ["Marketplace", "站点", "市场"],
    "currency": ["Currency", "Currency Code", "币种", "货币"],
    "campaign_id": ["Campaign ID", "Campaign Id", "广告活动ID", "广告活动 Id"],
    "campaign_name": ["Campaign Name", "Campaign", "广告活动名称", "广告活动"],
    "campaign_status": ["Campaign Status", "Campaign State", "广告活动状态"],
    "daily_budget": ["Daily Budget", "Campaign Budget", "预算", "每日预算", "广告活动预算"],
