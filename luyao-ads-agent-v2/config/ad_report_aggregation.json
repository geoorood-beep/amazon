    "clicks": ["Clicks", "Click", "点击量", "点击"],
    "orders": ["7 Day Total Orders (#)", "7 Day Total Orders", "14 Day Total Orders (#)", "14 Day Total Orders", "Orders", "广告订单量", "订单量", "订单"],
    "spend": ["Spend", "Cost", "广告花费", "花费", "支出"],
    "sales": ["7 Day Total Sales", "14 Day Total Sales", "Sales", "广告销售额", "销售额"]
  }
}
