    "ad_group_status": ["Ad Group Status", "Ad Group State", "广告组状态"],
    "default_bid": ["Default Bid", "Ad Group Default Bid", "默认竞价", "广告组默认竞价"],
    "target_id": ["Target ID", "Targeting ID", "Keyword ID", "投放对象ID", "关键词ID"],
    "target_text": ["Targeting", "Targeting Expression", "Keyword Text", "Keyword", "投放对象", "关键词"],
    "match_type": ["Match Type", "Keyword Type", "匹配类型", "关键词类型"],
