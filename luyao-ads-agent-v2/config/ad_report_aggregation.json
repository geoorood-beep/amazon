    "search_term": ["Customer Search Term", "Search Term", "客户搜索词", "搜索词"],
    "placement": ["Placement", "Placement Type", "广告位", "广告位置"],
    "sku": ["Advertised SKU", "SKU", "广告商品SKU", "广告SKU"],
    "asin": ["Advertised ASIN", "ASIN", "广告商品ASIN", "广告ASIN"],
